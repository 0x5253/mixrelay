{
  "name": "@mixrelay/control-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:ui": "node scripts/audit-ui.mjs",
    "build": "tsc --noEmit && vite build && node ../../scripts/check-webkit-syntax.mjs dist",
    "build-storybook": "storybook build",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm test:a11y && pnpm build && pnpm build-storybook",
    "check:boundaries": "node --test scripts/ui-boundary-rules.test.mjs scripts/audit-ui.test.mjs && node scripts/check-ui-boundaries.mjs",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --coverage",
    "test:a11y": "MIXRELAY_UI_A11Y=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "^12.12.1",
    "i18next": "26.7.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "css-tree": "3.2.1",
    "jsdom": "30.1.3",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "author": "rawsector <support@rawsector.com>",
  "homepage": "https://rawsector.com/products/mixrelay"
}
